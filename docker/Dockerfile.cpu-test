# CPU-only test Dockerfile for ktransformers AVX2 MoE kernels
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libnuma-dev \
    numactl \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    libopenmpi-dev \
    libhwloc-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install torch numpy tqdm --index-url https://download.pytorch.org/whl/cpu

WORKDIR /workspace

# Clone repo and initialize submodules
RUN git clone --recursive https://github.com/kvcache-ai/ktransformers.git /workspace/ktransformers \
    && cd /workspace/ktransformers \
    && git submodule update --init --recursive

# Copy local kt-kernel changes (our modifications)
COPY kt-kernel /workspace/ktransformers/kt-kernel

# Build kt-kernel with CPU MoE kernel enabled
WORKDIR /workspace/ktransformers/kt-kernel

RUN rm -rf build && mkdir -p build && cd build && \
    cmake .. \
        -DKTRANSFORMERS_USE_CUDA=OFF \
        -DKTRANSFORMERS_USE_MUSA=OFF \
        -DKTRANSFORMERS_USE_ROCM=OFF \
        -DKTRANSFORMERS_USE_MACA=OFF \
        -DKTRANSFORMERS_USE_SYCL=OFF \
        -DKTRANSFORMERS_USE_ASCEND_NPU=OFF \
        -DKTRANSFORMERS_CPU_MOE_KERNEL=ON \
        -DKTRANSFORMERS_CPU_USE_AMX_AVX512=OFF \
        -DKTRANSFORMERS_CPU_USE_KML=OFF \
        -DLLAMA_AVX2=ON \
        -DLLAMA_FMA=ON \
        -DCMAKE_BUILD_TYPE=Debug \
    && make -j$(nproc)

# Run benchmarks
WORKDIR /workspace/ktransformers/kt-kernel/bench

CMD ["/opt/venv/bin/python3", "bench_moe.py"]